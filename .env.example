# ============================================================
# Philsee 环境变量配置模板
# ============================================================
# 复制此文件为 .env 并填写真实的连接信息
# cp .env.example .env

# ============================================================
# VLM (视觉大模型) 配置
# ============================================================
# VLM 服务端点 URL
VLM_ENDPOINT=http://your-gateway/v1/chat/completions

# 模型名称
VLM_MODEL=qwen-vl-max

# API 密钥
VLM_API_KEY=your-api-key

# 最大生成 token 数
# 设置为 -1 或留空表示不限制（由模型自动决定）
VLM_MAX_TOKENS=-1

# 温度参数 (0.0 ~ 1.0)
VLM_TEMPERATURE=0.0

# 请求超时秒数
VLM_TIMEOUT=30

# 最大重试次数
VLM_MAX_RETRIES=2

# 是否启用思考模式 (true/false)
# 启用后模型会进行深度推理，适合复杂任务，但响应时间更长
VLM_ENABLE_THINKING=false

# ============================================================
# MinIO 对象存储配置
# ============================================================
# MinIO 服务端点 (不含协议前缀)
MINIO_ENDPOINT=localhost:9000

# 访问密钥
MINIO_ACCESS_KEY=admin

# 秘密密钥
MINIO_SECRET_KEY=admin123456

# 存储桶名称
MINIO_BUCKET=philsee-images

# 是否使用 HTTPS (true/false)
MINIO_SECURE=false

# ============================================================
# MySQL 数据库配置
# ============================================================
# 数据库主机
MYSQL_HOST=localhost

# 数据库端口
MYSQL_PORT=3306

# 数据库用户名
MYSQL_USER=root

# 数据库密码
MYSQL_PASSWORD=password

# 数据库名称
MYSQL_DATABASE=philsee

# ============================================================
# 图像预处理配置
# ============================================================
# 图片缩放目标短边长度 (像素)
IMAGE_TARGET_SHORT_EDGE=1024
